# Database - Elige una opción
# Para desarrollo local con SQLite (recomendado para desarrollo)
DATABASE_URL=sqlite+aiosqlite:///./kinemov.db

# Para PostgreSQL (descomentar si usas Docker o PostgreSQL local)
# DATABASE_URL=postgresql+asyncpg://kinemov:secret123@localhost:5432/kinemov

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Email (opcional - para desarrollo sin email)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=agustinjretamozo@gmail.com
EMAIL_PASS=dnhpafjkxxetrume
EMAIL_FROM=noreply@kinemov.com

# SMS Twilio (opcional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# CORS
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Environment
ENVIRONMENT=development

# Si true (por defecto), al iniciar la API se aplica metadata.create_all() con todos los modelos.
# Pon false en producción si gestionás el esquema solo con migraciones Alembic.
SYNC_DB_SCHEMA_ON_STARTUP=true
